PORT=3000
NODE_ENV=development

# PostgreSQL 16 (PostGIS + pgcrypto recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# pgcrypto symmetric key for senior medical_conditions_encrypted
MEDICAL_ENCRYPTION_KEY=replace-with-32-plus-char-key

# Signed voice/WhatsApp/IVR webhook
WEBHOOK_SIGNING_SECRET=replace-webhook-secret

# Optional: restrict POLICE_ADMIN self-registration
POLICE_ADMIN_INVITE_CODE=SHIRVA-PS-03

# Optional Redis (dead-man switch + token blacklist). In-process fallback is used if unset.
REDIS_URL=

# ERSS 112 sandbox
ERSS_112_URL=https://erss112.karnataka.gov.in/api/v1/dispatch/emergency-ingest
POLICE_DEPT_API_KEY=replace-police-dept-api-key
STATION_CODE=PS-03-SHIRVA
STATION_DISTRICT=Udupi

# Signed CCTV URL signing
CCTV_SIGNING_SECRET=replace-cctv-secret
CCTV_BASE_URL=https://cctv.shirva-ps03.karnataka.gov.in
